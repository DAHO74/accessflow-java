<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.accessflow.controller.TutorsController"
      styleClass="page-root" spacing="20">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Tutores" styleClass="page-title"/>
            <Label text="Padres y tutores vinculados a alumnos" styleClass="page-subtitle"/>
        </VBox>
        <Button text="+ Nuevo Tutor" styleClass="btn-primary" onAction="#handleAgregar"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="buscarField" promptText="Buscar tutor..." styleClass="search-field"
                   prefWidth="260" onAction="#handleBuscar"/>
        <Button text="Buscar" styleClass="btn-secondary" onAction="#handleBuscar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalLabel" text="Total: 0" styleClass="badge"/>
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colId"       text="ID"       prefWidth="60"/>
                <TableColumn fx:id="colNombre"   text="Nombre"   prefWidth="180"/>
                <TableColumn fx:id="colEmail"    text="Correo"   prefWidth="200"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120"/>
                <TableColumn fx:id="colAlumnos"  text="Alumnos"  prefWidth="90"/>
            </columns>
            <placeholder><Label text="No hay tutores registrados" styleClass="table-placeholder"/></placeholder>
        </TableView>

        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button text="Editar"   styleClass="btn-secondary" onAction="#handleEditar"/>
            <Button text="Eliminar" styleClass="btn-danger"    onAction="#handleEliminar"/>
        </HBox>
    </VBox>
</VBox>
