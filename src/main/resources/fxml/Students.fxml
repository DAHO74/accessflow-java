<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.accessflow.controller.StudentsController"
      styleClass="page-root" spacing="20">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Alumnos" styleClass="page-title"/>
            <Label text="Gestión de alumnos registrados" styleClass="page-subtitle"/>
        </VBox>
        <Button text="+ Agregar Alumno" styleClass="btn-primary" onAction="#handleAgregar"/>
    </HBox>

    <!-- Filters -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="buscarField" promptText="Buscar por nombre..." styleClass="search-field"
                   prefWidth="260" onAction="#handleBuscar"/>
        <Button text="Buscar" styleClass="btn-secondary" onAction="#handleBuscar"/>
        <Label text="Grupo:" styleClass="field-label"/>
        <ComboBox fx:id="grupoFiltro" prefWidth="160" onAction="#handleFiltroGrupo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalLabel" text="Total: 0" styleClass="badge"/>
    </HBox>

    <!-- Table -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colId"     text="ID"     prefWidth="60"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
                <TableColumn fx:id="colRfid"   text="RFID"   prefWidth="140"/>
                <TableColumn fx:id="colGrupo"  text="Grupo"  prefWidth="160"/>
            </columns>
            <placeholder><Label text="No hay alumnos registrados" styleClass="table-placeholder"/></placeholder>
        </TableView>

        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="btnEditar"   text="Editar"   styleClass="btn-secondary" onAction="#handleEditar"   disable="true"/>
            <Button fx:id="btnEliminar" text="Eliminar" styleClass="btn-danger"    onAction="#handleEliminar" disable="true"/>
        </HBox>
    </VBox>
</VBox>
