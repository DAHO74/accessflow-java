<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.accessflow.controller.GroupsController"
      styleClass="page-root" spacing="20">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Grupos" styleClass="page-title"/>
            <Label text="Gestión de grupos y grados escolares" styleClass="page-subtitle"/>
        </VBox>
        <Label fx:id="totalLabel" text="Total: 0 grupos" styleClass="badge"/>
        <Button text="+ Nuevo Grupo" styleClass="btn-primary" onAction="#handleAgregar"/>
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colId"      text="ID"      prefWidth="60"/>
                <TableColumn fx:id="colNombre"  text="Nombre"  prefWidth="180"/>
                <TableColumn fx:id="colGrado"   text="Grado"   prefWidth="120"/>
                <TableColumn fx:id="colTurno"   text="Turno"   prefWidth="120"/>
                <TableColumn fx:id="colAlumnos" text="Alumnos" prefWidth="100"/>
            </columns>
            <placeholder><Label text="No hay grupos registrados" styleClass="table-placeholder"/></placeholder>
        </TableView>

        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button text="Editar"   styleClass="btn-secondary" onAction="#handleEditar"/>
            <Button text="Eliminar" styleClass="btn-danger"    onAction="#handleEliminar"/>
        </HBox>
    </VBox>
</VBox>
