<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="com.accessflow.controller.MainController"
            styleClass="main-root">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="220">

            <!-- Brand -->
            <VBox styleClass="sidebar-brand" alignment="CENTER">
                <padding><Insets top="24" right="16" bottom="20" left="16"/></padding>
                <Label text="AF" styleClass="sidebar-logo"/>
                <Label text="AccessFlow" styleClass="sidebar-brand-name"/>
            </VBox>

            <!-- Admin Info -->
            <VBox styleClass="sidebar-admin" alignment="CENTER_LEFT">
                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                <Label fx:id="adminNombreLabel" styleClass="sidebar-admin-name" wrapText="true"/>
                <Label fx:id="adminEmailLabel"  styleClass="sidebar-admin-email" wrapText="true"/>
            </VBox>

            <Separator styleClass="sidebar-sep"/>

            <!-- Nav -->
            <VBox styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
                <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                <spacing>2</spacing>

                <Button fx:id="btnDashboard"   text="  Dashboard"    styleClass="nav-btn" maxWidth="Infinity" onAction="#handleDashboard"/>
                <Button fx:id="btnAsistencia"  text="  Asistencia"   styleClass="nav-btn" maxWidth="Infinity" onAction="#handleAsistencia"/>
                <Button fx:id="btnHistorial"   text="  Historial"    styleClass="nav-btn" maxWidth="Infinity" onAction="#handleHistorial"/>

                <Separator styleClass="nav-sep"/>

                <Label text="GESTIÓN" styleClass="nav-section-label"/>
                <Button fx:id="btnAlumnos"     text="  Alumnos"      styleClass="nav-btn" maxWidth="Infinity" onAction="#handleAlumnos"/>
                <Button fx:id="btnGrupos"      text="  Grupos"       styleClass="nav-btn" maxWidth="Infinity" onAction="#handleGrupos"/>
                <Button fx:id="btnTutores"     text="  Tutores"      styleClass="nav-btn" maxWidth="Infinity" onAction="#handleTutores"/>

                <Separator styleClass="nav-sep"/>

                <Label text="COMUNICACIÓN" styleClass="nav-section-label"/>
                <Button fx:id="btnMensajeria"  text="  Mensajería"   styleClass="nav-btn" maxWidth="Infinity" onAction="#handleMensajeria"/>
                <Button fx:id="btnReportes"    text="  Reportes"     styleClass="nav-btn" maxWidth="Infinity" onAction="#handleReportes"/>
            </VBox>

            <!-- Bottom -->
            <VBox styleClass="sidebar-bottom">
                <padding><Insets top="8" right="8" bottom="16" left="8"/></padding>
                <spacing>2</spacing>
                <Separator styleClass="nav-sep"/>
                <Button fx:id="btnPerfil"        text="  Mi Perfil"       styleClass="nav-btn" maxWidth="Infinity" onAction="#handlePerfil"/>
                <Button fx:id="btnConfiguracion" text="  Acerca de"       styleClass="nav-btn" maxWidth="Infinity" onAction="#handleConfiguracion"/>
                <Button                          text="  Cerrar Sesión"   styleClass="nav-btn nav-logout" maxWidth="Infinity" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENT -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>
</BorderPane>
