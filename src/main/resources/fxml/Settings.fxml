<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.accessflow.controller.AboutController"
      styleClass="page-root" spacing="20">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <Label text="Acerca de AccessFlow" styleClass="page-title"/>
    <Label text="Información del sistema y equipo de desarrollo" styleClass="page-subtitle"/>

    <!-- App Info -->
    <VBox styleClass="card" spacing="16" maxWidth="600">
        <Label text="AccessFlow" styleClass="card-title"/>
        <Label text="Sistema de control de asistencia escolar con tecnología RFID."
               styleClass="page-subtitle" wrapText="true"/>

        <VBox spacing="8">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Versión:" styleClass="field-label" minWidth="140"/>
                <Label text="1.0.0" styleClass="info-value"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Plataforma:" styleClass="field-label" minWidth="140"/>
                <Label text="Escritorio  (Windows / macOS / Linux)" styleClass="info-value"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- Team -->
    <VBox styleClass="card" spacing="16" maxWidth="600">
        <Label text="Equipo de desarrollo" styleClass="card-title"/>

        <VBox spacing="4">
            <Label text="Dylan Alexis Hernandez Oliver" styleClass="field-label"/>
            <Label text="Desarrollador" styleClass="page-subtitle"/>
        </VBox>
        <Separator/>
        <VBox spacing="4">
            <Label text="David Mondragon Lopez" styleClass="field-label"/>
            <Label text="Desarrollador" styleClass="page-subtitle"/>
        </VBox>
        <Separator/>
        <VBox spacing="4">
            <Label text="Arturo Salinas Rugerio" styleClass="field-label"/>
            <Label text="Desarrollador" styleClass="page-subtitle"/>
        </VBox>
    </VBox>

</VBox>
