<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<DialogPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.accessflow.controller.GroupFormController"
            prefWidth="360" prefHeight="280">

    <header><Label text="Datos del Grupo" styleClass="dialog-header"/></header>

    <content>
        <VBox spacing="14">
            <padding><Insets top="16" right="4" bottom="8" left="4"/></padding>

            <VBox spacing="6">
                <Label text="Nombre del grupo *" styleClass="field-label"/>
                <TextField fx:id="nombreField" promptText="Ej: 1A, Primero A" styleClass="form-field"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Grado *" styleClass="field-label"/>
                <TextField fx:id="gradoField" promptText="Ej: Primero, Segundo" styleClass="form-field"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Turno" styleClass="field-label"/>
                <ComboBox fx:id="turnoCombo" prefWidth="Infinity"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

            <Button fx:id="guardarBtn" text="Guardar" styleClass="btn-primary" maxWidth="Infinity"/>
        </VBox>
    </content>
</DialogPane>
