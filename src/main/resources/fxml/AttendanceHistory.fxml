<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.accessflow.controller.AttendanceHistoryController"
      styleClass="page-root" spacing="20">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <Label text="Historial de Asistencias" styleClass="page-title"/>
    <Label text="Consulta registros por fecha, grupo o alumno" styleClass="page-subtitle"/>

    <!-- Filters -->
    <VBox styleClass="card" spacing="14">
        <Label text="Filtros" styleClass="card-title"/>
        <HBox spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label text="Desde" styleClass="field-label"/>
                <DatePicker fx:id="desdeField" styleClass="date-picker"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Hasta" styleClass="field-label"/>
                <DatePicker fx:id="hastaField" styleClass="date-picker"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Grupo" styleClass="field-label"/>
                <ComboBox fx:id="grupoCombo" prefWidth="180"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Alumno" styleClass="field-label"/>
                <ComboBox fx:id="alumnoCombo" prefWidth="180"/>
            </VBox>
            <VBox spacing="6">
                <Label text=" " styleClass="field-label"/>
                <HBox spacing="8">
                    <Button text="Buscar" styleClass="btn-primary" onAction="#buscar"/>
                    <Button text="Limpiar" styleClass="btn-secondary" onAction="#limpiarFiltros"/>
                </HBox>
            </VBox>
        </HBox>
        <Label fx:id="totalLabel" text="Total: 0 registros" styleClass="badge"/>
    </VBox>

    <!-- Table -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colNombre"  text="Alumno"  prefWidth="180"/>
                <TableColumn fx:id="colGrupo"   text="Grupo"   prefWidth="120"/>
                <TableColumn fx:id="colFecha"   text="Fecha"   prefWidth="110"/>
                <TableColumn fx:id="colEntrada" text="Entrada" prefWidth="90"/>
                <TableColumn fx:id="colSalida"  text="Salida"  prefWidth="90"/>
                <TableColumn fx:id="colEstado"  text="Estado"  prefWidth="110"/>
            </columns>
            <placeholder><Label text="Sin resultados" styleClass="table-placeholder"/></placeholder>
        </TableView>
    </VBox>
</VBox>
