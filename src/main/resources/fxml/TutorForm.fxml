<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<DialogPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.accessflow.controller.TutorFormController"
            prefWidth="400" prefHeight="380">

    <header><Label text="Datos del Tutor" styleClass="dialog-header"/></header>

    <content>
        <VBox spacing="12">
            <padding><Insets top="16" right="4" bottom="8" left="4"/></padding>

            <VBox spacing="6">
                <Label text="Nombre completo *" styleClass="field-label"/>
                <TextField fx:id="nombreField" promptText="Nombre del tutor" styleClass="form-field"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Correo electrónico" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="tutor@email.com" styleClass="form-field"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Teléfono" styleClass="field-label"/>
                <TextField fx:id="telefonoField" promptText="55 1234 5678" styleClass="form-field"/>
            </VBox>
            <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Vincular alumno" styleClass="field-label"/>
                    <ComboBox fx:id="alumnoCombo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" prefWidth="150" HBox.hgrow="NEVER">
                    <Label text="Parentesco" styleClass="field-label"/>
                    <ComboBox fx:id="parentescoCombo" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

            <Button fx:id="guardarBtn" text="Guardar" styleClass="btn-primary" maxWidth="Infinity"/>
        </VBox>
    </content>
</DialogPane>
