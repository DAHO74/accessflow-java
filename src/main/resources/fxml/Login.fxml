<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.accessflow.controller.LoginController"
           styleClass="auth-root">

    <VBox styleClass="auth-card" maxWidth="380" maxHeight="480" alignment="CENTER">
        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
        <spacing>16</spacing>

        <!-- Logo -->
        <VBox alignment="CENTER" spacing="4">
            <Label text="AF" styleClass="auth-logo"/>
            <Label text="AccessFlow" styleClass="auth-title"/>
            <Label text="Sistema de Asistencia Escolar" styleClass="auth-subtitle"/>
        </VBox>

        <Region VBox.vgrow="NEVER" minHeight="12"/>

        <!-- Form -->
        <VBox spacing="8">
            <Label text="Correo electrónico" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="admin@escuela.edu"
                       styleClass="auth-field" onKeyPressed="#handleEnter"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Contraseña" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="••••••••"
                           styleClass="auth-field" onKeyPressed="#handleEnter"/>
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

        <Button text="Iniciar Sesión" fx:id="loginBtn"
                styleClass="btn-primary" maxWidth="Infinity"
                onAction="#handleLogin"/>

        <HBox alignment="CENTER" spacing="4">
            <Label text="¿Primera vez?" styleClass="link-text"/>
            <Hyperlink text="Crear cuenta de administrador" onAction="#handleRegistro"
                       styleClass="link-btn"/>
        </HBox>
    </VBox>
</StackPane>
